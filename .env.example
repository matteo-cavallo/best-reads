# Public base URL of this server (OAuth issuer + resource URL). Must be https in production.
PUBLIC_URL=http://localhost:3000
PORT=3000
# SQLite file path (":memory:" allowed for tests)
DB_PATH=./data/best-reads.db
# Single-user owner password shown on the OAuth consent page. REQUIRED in production.
OWNER_PASSWORD=change-me
# Optional static bearer token for dev/tests/curl (accepted in addition to OAuth tokens). Min 24 chars.
STATIC_BEARER_TOKEN=
# Open Library
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_COVERS_URL=https://covers.openlibrary.org
# Contact for the Open Library User-Agent (they ask for an identifying UA). Generic default is fine.
OPENLIBRARY_CONTACT=
OPENLIBRARY_TIMEOUT_MS=8000
# OAuth token lifetimes (seconds)
ACCESS_TOKEN_TTL_S=3600
REFRESH_TOKEN_TTL_S=2592000
NODE_ENV=development
